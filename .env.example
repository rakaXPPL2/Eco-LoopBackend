APP_NAME="Eco-Loop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Locale
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Database (Update untuk Production)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=eco_loop
DB_USERNAME=postgres
DB_PASSWORD=password

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@eco-loop.id"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

VITE_APP_NAME="${APP_NAME}"

# Frontend URL (untuk CORS)
FRONTEND_URL=https://eco-loop-frontend.vercel.app
